<mxfile host="app.diagrams.net"><diagram name="Анонімізація і публікація» (UC-06, UC-07)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1340" pageHeight="1870"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Activity Diagram «Анонімізація і публікація» (UC-06, UC-07)" style="text;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1340" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Provider" style="rounded=0;html=1;fillColor=none;strokeColor=#555555;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="56" width="340" height="1810" as="geometry"/></mxCell><mxCell id="c4" value="Система" style="rounded=0;html=1;fillColor=none;strokeColor=#555555;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="56" width="1000" height="1810" as="geometry"/></mxCell><mxCell id="c5" value="" style="ellipse;html=1;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="153" y="113" width="34" height="34" as="geometry"/></mxCell><mxCell id="c6" value="Переглянути PII-колонки&lt;br&gt;і рекомендовані методи&lt;br&gt;(UC-05, UC-06)" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E8F0FA;strokeColor=#2A4F8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="220" width="250" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Обрати метод для кожної&lt;br&gt;колонки: маскування, HMAC,&lt;br&gt;узагальнення або без методу" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E8F0FA;strokeColor=#2A4F8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="348" width="270" height="84" as="geometry"/></mxCell><mxCell id="c8" value="Показати прев'ю «до/після»&lt;br&gt;на перших рядках" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E8F0FA;strokeColor=#2A4F8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="515" y="358" width="270" height="64" as="geometry"/></mxCell><mxCell id="c9" value="результат&lt;br&gt;влаштовує?" style="rhombus;html=1;fillColor=#FFF6D6;strokeColor=#8C6D1F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="240" height="100" as="geometry"/></mxCell><mxCell id="c10" value="Натиснути «Створити&lt;br&gt;очищену версію»" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E8F0FA;strokeColor=#2A4F8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="618" width="250" height="64" as="geometry"/></mxCell><mxCell id="c11" value="ключ HMAC заданий&lt;br&gt;(якщо обрано HMAC)?" style="rhombus;html=1;fillColor=#FFF6D6;strokeColor=#8C6D1F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="600" width="340" height="100" as="geometry"/></mxCell><mxCell id="c12" value="Блокувати створення версії:&lt;br&gt;помилка конфігурації" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#FBE9E9;strokeColor=#AA3333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="614" width="300" height="72" as="geometry"/></mxCell><mxCell id="c13" value="" style="ellipse;html=1;shape=endState;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="1253" y="633" width="34" height="34" as="geometry"/></mxCell><mxCell id="c14" value="Застосувати методи, виключити записи&lt;br&gt;reject; створити незмінну версію&lt;br&gt;і lineage; аудит ANONYMIZE" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E8F0FA;strokeColor=#2A4F8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455" y="738" width="390" height="84" as="geometry"/></mxCell><mxCell id="c15" value="Вказати правову підставу (за&lt;br&gt;потреби) і термін зберігання;&lt;br&gt;натиснути «Опублікувати»" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E8F0FA;strokeColor=#2A4F8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="738" width="270" height="84" as="geometry"/></mxCell><mxCell id="c16" value="Перевірити ворота публікації" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E8F0FA;strokeColor=#2A4F8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="515" y="880" width="270" height="60" as="geometry"/></mxCell><mxCell id="c17" value="профілювання і правила виконано,&lt;br&gt;block-порушень немає?" style="rhombus;html=1;fillColor=#FFF6D6;strokeColor=#8C6D1F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="994" width="430" height="92" as="geometry"/></mxCell><mxCell id="c18" value="Відмовити з переліком&lt;br&gt;невиконаних умов; аудит DENY" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#FBE9E9;strokeColor=#AA3333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="1004" width="300" height="72" as="geometry"/></mxCell><mxCell id="c19" value="" style="ellipse;html=1;shape=endState;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="1253" y="1023" width="34" height="34" as="geometry"/></mxCell><mxCell id="c20" value="PII оброблено маскуванням чи&lt;br&gt;узагальненням, або є правова&lt;br&gt;підстава?" style="rhombus;html=1;fillColor=#FFF6D6;strokeColor=#8C6D1F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="1120" width="440" height="100" as="geometry"/></mxCell><mxCell id="c21" value="Відмовити: PII без методу або&lt;br&gt;лише HMAC без підстави; DENY" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#FBE9E9;strokeColor=#AA3333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="1134" width="300" height="72" as="geometry"/></mxCell><mxCell id="c22" value="" style="ellipse;html=1;shape=endState;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="1253" y="1153" width="34" height="34" as="geometry"/></mxCell><mxCell id="c23" value="термін зберігання&lt;br&gt;задано?" style="rhombus;html=1;fillColor=#FFF6D6;strokeColor=#8C6D1F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1250" width="340" height="100" as="geometry"/></mxCell><mxCell id="c24" value="Відмовити: не задано термін&lt;br&gt;зберігання; аудит DENY" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#FBE9E9;strokeColor=#AA3333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="1264" width="300" height="72" as="geometry"/></mxCell><mxCell id="c25" value="" style="ellipse;html=1;shape=endState;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="1253" y="1283" width="34" height="34" as="geometry"/></mxCell><mxCell id="c26" value="усі PII-колонки оброблено&lt;br&gt;маскуванням або узагальненням?" style="rhombus;html=1;fillColor=#FFF6D6;strokeColor=#8C6D1F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1384" width="420" height="92" as="geometry"/></mxCell><mxCell id="c27" value="Знизити клас очищеної&lt;br&gt;версії до Confidential" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E8F0FA;strokeColor=#2A4F8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="515" y="1528" width="270" height="64" as="geometry"/></mxCell><mxCell id="c28" value="Клас лишається Personal&lt;br&gt;(потрібна правова підстава)" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E8F0FA;strokeColor=#2A4F8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="1395" width="300" height="70" as="geometry"/></mxCell><mxCell id="c29" value="Статус «опубліковано»; набір у каталозі;&lt;br&gt;аудит PUBLISH" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E6F4E6;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455" y="1655" width="390" height="70" as="geometry"/></mxCell><mxCell id="c30" value="Побачити перелік воріт&lt;br&gt;з позначкою «виконано»" style="rounded=1;arcSize=25;html=1;whiteSpace=wrap;fillColor=#E6F4E6;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="1655" width="250" height="70" as="geometry"/></mxCell><mxCell id="c31" value="" style="ellipse;html=1;shape=endState;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x=