@startuml
!pragma layout smetana
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam roundcorner 8
skinparam shadowing false
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
}
skinparam sequence {
    ArrowColor #2C3E50
    LifeLineBorderColor #95A5A6
    LifeLineBackgroundColor #F8F9F9
}

title Data Clean Room - Publication Sequence (Sprint 3, SCRUM-59)

actor Provider
participant Frontend
participant "API\n(FastAPI)" as API
participant "AuthZ\n(RBAC)" as AuthZ
participant Anonymizer
participant "PublicationGate" as Gate
participant "LegalBasisService" as LBS
database DB
participant FileStorage
participant AuditLog

autonumber

== Preview anonymization (read-only) ==
Provider -> Frontend: select dataset
Frontend -> API: POST /api/datasets/{id}/anonymize/preview
API -> AuthZ: require dataset owner (DataProvider)
AuthZ --> API: allowed
API -> DB: load dataset and PII findings
DB --> API: dataset state
API -> Anonymizer: preview anonymization\n(mask / generalize / hmac)
Anonymizer -> FileStorage: read raw version
FileStorage --> Anonymizer: raw file
Anonymizer --> API: preview clean data and methods
API --> Frontend: 200 {preview, methods}
Frontend --> Provider: review anonymization

== Create clean version ==
Provider -> Frontend: confirm anonymization
Frontend -> API: POST /api/datasets/{id}/anonymize
API -> AuthZ: require dataset owner (DataProvider)
AuthZ --> API: allowed
API -> Anonymizer: apply anonymization\n(mask / generalize / hmac)
Anonymizer -> FileStorage: read raw version
FileStorage --> Anonymizer: raw file
Anonymizer --> API: clean version and methods
API -> DB: persist DatasetVersion(kind=clean)\nand AnonymizationMethod[]
API --> Frontend: 201 Created {version_id}
Frontend --> Provider: clean version ready

== Publish check (read-only) ==
Provider -> Frontend: select retention_until
Frontend -> API: GET /api/datasets/{id}/publish/check\n?retention_until=YYYY-MM-DD
API -> AuthZ: require dataset owner (DataProvider)
AuthZ --> API: allowed
API -> Gate: evaluate(dataset)
Gate -> DB: check clean version, PII coverage,\nHMAC legal basis and retention
Gate -> LBS: check_legal_basis(dataset)\nonly if any HMAC method
LBS --> Gate: ok or reason
Gate --> API: GateResult{allowed, reasons, new_class}
alt allowed
    API --> Frontend: 200 {allowed: true, new_class}
else denied
    API --> Frontend: 200 {allowed: false, reasons[]}
end

== Publish ==
Provider -> Frontend: confirm publication
Frontend -> API: POST /api/datasets/{id}/publish\n{retention_until}
API -> AuthZ: require dataset owner (DataProvider)
AuthZ --> API: allowed
API -> Gate: evaluate(dataset)
Gate -> DB: re-check clean version, PII coverage,\nHMAC legal basis and retention
Gate -> LBS: check_legal_basis(dataset)\nonly if any HMAC method
LBS --> Gate: ok or reason
alt allowed
    Gate --> API: new_class
    API -> DB: update status=published,\npublished_at, retention_until, data_class
    API -> AuditLog: log PUBLISH\n{class, retention}
    API --> Frontend: 200 Published
    Frontend --> Provider: dataset published
else denied
    Gate --> API: reasons[]
    API -> AuditLog: log DENY\n{reasons}
    API --> Frontend: 422 Unprocessable Entity\n{reasons}
end

note over Gate
  Gate reasons:
  no_clean_version
  pii_not_processed
  hmac_without_legal_basis
  retention_required
end note

note over Gate, LBS
  Publication checks any active legal basis (no purpose).
  Purpose is validated per exchange request (UC-09).
  Decision recorded in governance 3.5.
end note

note over DB
  Class rules:
  no PII -> Internal
  all PII masked or generalized -> Confidential
  any HMAC column -> Personal
end note

@enduml
