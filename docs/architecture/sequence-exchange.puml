@startuml
!pragma layout smetana
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam roundcorner 8
skinparam shadowing false
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
}
skinparam sequence {
    ArrowColor #2C3E50
    LifeLineBorderColor #95A5A6
    LifeLineBackgroundColor #F8F9F9
}

title Data Clean Room - Exchange Request Sequence (Sprint 3, SCRUM-59)

actor Consumer
actor Steward
participant Frontend
participant "API\n(FastAPI)" as API
participant "AuthZ\n(RBAC)" as AuthZ
participant "LegalBasisService" as LBS
database DB
participant FileStorage
participant AuditLog

autonumber

== Create exchange request ==
Consumer -> Frontend: request access to a published dataset
Frontend -> API: POST /api/requests\n{dataset_id, purpose}
API -> AuthZ: require role DataConsumer
AuthZ --> API: allowed
API -> DB: load dataset and clean version
DB --> API: dataset (status=published, clean version)
API -> DB: insert ExchangeRequest(status=pending)
API -> AuditLog: log REQUEST
API --> Frontend: 201 Created
Frontend --> Consumer: request submitted

== Approve or reject request ==
Steward -> Frontend: open pending request
Frontend -> API: POST /api/requests/{id}/approve
API -> AuthZ: require DataSteward or dataset owner
AuthZ --> API: allowed
API -> LBS: check_legal_basis(dataset, purpose)
alt legal basis is valid
    LBS --> API: ok
    API -> DB: update status=approved,\nreviewer_id, reviewed_at
    API -> AuditLog: log APPROVE
    API --> Frontend: 200 Approved
else no legal basis / revoked / expired / purpose mismatch
    LBS --> API: reason
    API -> AuditLog: log DENY\nreason=legal_basis_invalid
    API --> Frontend: 409 Conflict\n{reason}
end
Frontend --> Steward: decision saved

group Reject request
    Steward -> Frontend: reject with a reason
    Frontend -> API: POST /api/requests/{id}/reject\n{reason}
    API -> AuthZ: require DataSteward or dataset owner
    AuthZ --> API: allowed
    API -> DB: update status=rejected,\nreview_comment, reviewed_at
    API -> AuditLog: log REJECT
    API --> Frontend: 200 Rejected
    Frontend --> Steward: request rejected
end

== Download clean version ==
Consumer -> Frontend: download approved dataset
Frontend -> API: GET /api/requests/{id}/download
API -> AuthZ: require role DataConsumer
AuthZ --> API: allowed
API -> DB: load request and dataset version
DB --> API: request (approved), version (clean)
API -> LBS: check_legal_basis(dataset, purpose)
alt consent is valid and version is clean
    LBS --> API: ok
    API -> FileStorage: read clean version
    FileStorage --> API: file stream
    API -> AuditLog: log DOWNLOAD
    API --> Frontend: 200 file
    Frontend --> Consumer: clean dataset
else consent revoked between approval and download
    LBS --> API: revoked
    API -> AuditLog: log DENY\nreason=legal_basis_invalid
    API --> Frontend: 403 Forbidden\n{reason}
end

note over API, FileStorage
  Raw Personal data is never served.
  A raw-version download is always 403 + DENY.
end note

@enduml
