# Скопіюй цей файл у .env і за потреби зміни значення.

# Базова адреса API. Порожнє значення = той самий origin; у dev запити на /api йдуть через проксі Vite.
# Для прямого звернення до бекенду вкажи, наприклад, http://localhost:8000 (тоді на бекенді потрібен CORS).
VITE_API_URL=

# Куди проксіювати /api у dev-режимі.
VITE_PROXY_TARGET=http://localhost:8000

# true = працювати із заглушкою (без бекенду). Постав false, коли API готовий.
VITE_USE_MOCK=true
